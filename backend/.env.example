PORT=5000
MONGODB_URI=mongodb://localhost:27017/instagram-clone
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# Cloudinary credentials: keep these in backend/.env only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional password-reset email settings.
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
FROM_NAME=Instagram Clone

CLIENT_URL=http://localhost:5173
